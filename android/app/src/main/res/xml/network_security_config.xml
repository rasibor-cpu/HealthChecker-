<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release: system CAs only; no cleartext. -->
    <base-config cleartextTrafficPermitted="false" />
    <!-- Debug/local-dev only: allow cleartext to private LAN for pairing experiments. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
