<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug source-set only. Release uses main/res/xml/network_security_config.xml
  with cleartextTrafficPermitted="false".
  Local-dev cleartext is further gated in HostClient by BuildConfig flags.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
