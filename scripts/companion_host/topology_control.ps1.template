# HC-304BR1 / HC-306E-R2 - Topology control (REVIEW ONLY)
#
# Always-on mechanism (HC-306E-R2): Windows Task Scheduler startup tasks
#   HealthCheckerCompanionHost, HealthCheckerCompanionProxy
# NOT Windows services. NSSM and WinSW are REJECTED.
#
# Corrected topology (mandatory):
#   Phone over private tailnet
#     -> Tailscale Serve HTTPS (private; never Funnel)
#       -> local trusted reverse proxy on 127.0.0.1 (injects X-HC-Proxy-Token)
#         -> Companion Host on a different 127.0.0.1 port
#
# Official Serve reference: https://tailscale.com/kb/1242/tailscale-serve
# Custom secret-header injection is NOT currently documented for Tailscale Serve;
# do not claim Serve -> Companion Host direct compatibility.
#
# Startup order (fail closed at each boundary):
#   1) Companion Host   (127.0.0.1:HC_BIND_PORT, default 8743)  [scheduled task]
#   2) Local trusted proxy (127.0.0.1:HC_PROXY_LISTEN_PORT, default 8744) [scheduled task, delayed]
#   3) Tailscale Serve -> http://127.0.0.1:HC_PROXY_LISTEN_PORT  [manual; never auto in tasks]
#
# Shutdown order: reverse (Serve -> proxy -> Companion Host).
#
# Health checks (no secrets in output):
#   - Companion: GET http://127.0.0.1:8743/healthz  (loopback only)
#   - Proxy:     GET http://127.0.0.1:8744/healthz  (proxied; still no token in body)
#   - Serve:     tailscale serve status --json  (must not mention Funnel)
#
# This template refuses unless HC_304_ALLOW_TOPOLOGY_SCRIPTS=I_UNDERSTAND.
# Task install/control: HC_306E_ALLOW_SCHEDULED_HOST + control_scheduled_tasks.ps1.template
# Do not execute during certification gates.

param(
    [Parameter(Mandatory = $true)]
    [ValidateSet("start", "stop", "health")]
    [string]$Action,

    [int]$CompanionPort = 8743,
    [int]$ProxyPort = 8744
)

$ErrorActionPreference = "Stop"
if ($env:HC_304_ALLOW_TOPOLOGY_SCRIPTS -ne "I_UNDERSTAND") {
    Write-Host "REFUSING: topology control template is inert until HC_304_ALLOW_TOPOLOGY_SCRIPTS=I_UNDERSTAND"
    exit 2
}

if ($CompanionPort -eq $ProxyPort) { throw "Refuse: proxy and Companion Host ports must differ" }
if ($CompanionPort -in 8765, 8877 -or $ProxyPort -in 8765, 8877) {
    throw "Refuse: reserved ports 8765 (CSS) / 8877 (HC-303D) forbidden"
}
if ($CompanionPort -lt 1024 -or $ProxyPort -lt 1024) { throw "Refuse: privileged ports forbidden" }

function Test-Boundary([string]$Name, [string]$Url) {
    try {
        $r = Invoke-WebRequest -Uri $Url -UseBasicParsing -TimeoutSec 5
        $body = [string]$r.Content
        if ($body -match '(?i)(token|pepper|admin|proxy_shared)') {
            throw "$Name health body appears to expose secret-like fields"
        }
        Write-Host "OK $Name $($r.StatusCode) $Url"
    }
    catch {
        Write-Host "FAIL $Name $Url : $_"
        throw
    }
}

switch ($Action) {
    "start" {
        Write-Host "1/3 Start scheduled task HealthCheckerCompanionHost (see control_scheduled_tasks.ps1.template)"
        # Start-ScheduledTask -TaskName HealthCheckerCompanionHost
        Write-Host "2/3 Start scheduled task HealthCheckerCompanionProxy (Caddy; env-injected token; no secrets on CLI)"
        # Start-ScheduledTask -TaskName HealthCheckerCompanionProxy
        Write-Host "3/3 Configure Tailscale Serve -> 127.0.0.1:$ProxyPort (manual; see configure_tailscale_serve.ps1.template)"
        Write-Host "STOP: tasks/Serve are not started by this inert topology template. NSSM/WinSW rejected."
        exit 0
    }
    "stop" {
        Write-Host "1/3 Reset/stop Tailscale Serve (tailscale serve reset)"
        Write-Host "2/3 Stop scheduled task HealthCheckerCompanionProxy"
        Write-Host "3/3 Stop scheduled task HealthCheckerCompanionHost"
        Write-Host "STOP: fill real stop commands only after approval (control_scheduled_tasks.ps1.template)."
        exit 0
    }
    "health" {
        Test-Boundary "companion" "http://127.0.0.1:$CompanionPort/healthz"
        Test-Boundary "proxy" "http://127.0.0.1:$ProxyPort/healthz"
        Write-Host "Serve: run 'tailscale serve status --json' and confirm no Funnel (manual)."
        exit 0
    }
}
