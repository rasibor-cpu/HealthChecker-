# HC-304B / HC-304BR1 / HC-306E-R2 companion-only host — example environment file
# Copy outside Git, e.g. %ProgramData%\HealthChecker\companion_host\host.env
# NEVER commit real secrets. NEVER pass secrets on the command line or in task XML.
#
# Loaded by the scheduled-task bootstrap allowlisted parser (host_env_loader.ps1)
# before:
#   python -m backend.health_vault.companion_host
# Always-on mechanism: Windows Task Scheduler (NOT NSSM/WinSW Windows services).
#
# Corrected topology (HC-304BR1):
#   Phone (tailnet) → Tailscale Serve HTTPS → local trusted proxy (127.0.0.1)
#     → Companion Host (different 127.0.0.1 port)
# Tailscale Serve does NOT document custom secret-header injection; do not point
# Serve directly at Companion Host. See https://tailscale.com/kb/1242/tailscale-serve

HC_HOST_ACTIVATION=enabled
HC_COMPANION_ADMIN_TOKEN=replace-with-long-random-admin-token-min-24
HC_COMPANION_PEPPER=replace-with-long-random-pepper-min-24chars
HC_PROXY_SHARED_TOKEN=replace-with-long-random-proxy-token-min24
HC_MONITORING_VAULT_ROOT=C:\HealthCheckerData\monitoring_vault
HC_TRUSTED_PROXY_MODE=tailscale_https
HC_EXTERNAL_HTTPS_ORIGIN=https://REPLACE-DEVICE.REPLACE-TAILNET.ts.net
# Hostname-only value for the local proxy (Caddy {env.HC_EXTERNAL_HTTPS_HOST}):
HC_EXTERNAL_HTTPS_HOST=REPLACE-DEVICE.REPLACE-TAILNET.ts.net

# Port placeholders (must differ; never 8765 CSS / 8877 HC-303D; loopback only)
HC_BIND_HOST=127.0.0.1
HC_BIND_PORT=8743
HC_PROXY_LISTEN_HOST=127.0.0.1
HC_PROXY_LISTEN_PORT=8744
HC_TAILSCALE_SERVE_TARGET_PORT=8744

# Local trusted proxy (Caddyfile.template + start_local_proxy.ps1.template) must:
# - refuse start without HC_PROXY_SHARED_TOKEN / matching HC_EXTERNAL_HTTPS_HOST
# - bind 127.0.0.1:HC_PROXY_LISTEN_PORT only
# - strip inbound X-HC-Proxy-Token / Forwarded / X-Forwarded-* (exact + wildcard)
# - set X-Forwarded-Proto: https and X-Forwarded-Host from env (after delete)
# - inject X-HC-Proxy-Token from HC_PROXY_SHARED_TOKEN env (never literal config)
# - preserve Authorization for Companion Bearer delivery
# - reverse_proxy to 127.0.0.1:HC_BIND_PORT
#
# Tailscale Serve (configure_tailscale_serve.ps1.template) must:
# - use Serve only (never Funnel / public)
# - forward only to http://127.0.0.1:HC_PROXY_LISTEN_PORT
# - parse AllowFunnel JSON values (true only), not substring "funnel"
#
# Startup order: Companion Host → local proxy → Tailscale Serve
# Shutdown: reverse
# Pilot assumption: single-user Windows host (loopback bypasses Tailscale ACL)

# Optional test-only (never set in production):
# HC_HOST_ALLOW_TESTCLIENT_PEER=1
