# HC-306E-R2 — Legacy service_control redirect (INERT)
#
# HealthChecker always-on units are scheduled startup tasks, not Windows services.
# This file no longer calls Start-Service / Stop-Service for HealthCheckerCompanionHost.
#
# Use: control_scheduled_tasks.ps1.template -Action start|stop|status|uninstall|rollback
# Approval: HC_306E_ALLOW_SCHEDULED_HOST=I_UNDERSTAND

param(
    [Parameter(Mandatory = $true)]
    [ValidateSet('start', 'stop', 'status')]
    [string]$Action
)

$ErrorActionPreference = 'Stop'
Write-Host 'REFUSING: service_control.ps1.template is retired for Windows services.'
Write-Host 'Use control_scheduled_tasks.ps1.template with ScheduledTasks cmdlets.'
Write-Host 'NSSM/WinSW remain REJECTED.'
Write-Host ("requested_action=" + $Action)
if ($env:HC_304B_ALLOW_SERVICE_SCRIPTS -eq 'I_UNDERSTAND') {
    Write-Host 'HC_304B_ALLOW_SERVICE_SCRIPTS no longer starts HealthChecker Windows services.'
}
exit 2
